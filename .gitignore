# ==============================================================================
# .gitignore for fpga-constraint-library
# Excludes output files generated by Vivado, Quartus, and Lattice tools
# when engineers clone this repo and run tools locally.
# ==============================================================================

# ── Xilinx Vivado ─────────────────────────────────────────────────────────────
.Xil/
*.jou
*.log
*.str
*.debug
vivado_*.str
vivado*.jou
vivado*.log
webtalk*.jou
webtalk*.log
webtalk/

# Vivado project output directories
*.runs/
*.cache/
*.ip_user_files/
*.sim/
*.gen/
*.hw/
*.xpr
*.bit
*.bin
*.ltx
*.rpt
*.pb
*.wdb
hd_visual/
*.xsa

# Vivado IP output
*.xci
*.xcix
ip/
managed_ip_project/

# ── Intel Quartus ─────────────────────────────────────────────────────────────
db/
incremental_db/
output_files/
simulation/
*.qpf
*.qws
*.sof
*.pof
*.jic
*.svf
*.ttf
*.rbf
*.ekp
*.esf
*.map
*.fit
*.asm
*.sta
*.tan
*.pin
*.smsg
*.rpt
*.summary
*.done
*.cdf
greybox_tmp/

# ── Lattice (iCEcube2, Radiant, nextpnr) ──────────────────────────────────────
*.asc
*.config
*.svf
sbt_backend/
synlog/
impl1/
impl2/
work/
*.bin
*.hex
*.out.config
planAhead_run_*/

# ── nextpnr / Yosys / Project Trellis ────────────────────────────────────────
*.json
*.blif
*.edif

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# ── Simulation ────────────────────────────────────────────────────────────────
*.vcd
*.ghw
*.fst
work-obj93.cf
work-obj08.cf

# ── Do NOT ignore these (always commit) ───────────────────────────────────────
# .xdc  .sdc  .lpf  .qsf  .md  .py  .tcl  .sh  .yml
