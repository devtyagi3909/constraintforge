# ---
# Tang Nano 9K Master Constraint File (.cst)
# Device: Gowin GW1NR-9C QN88P (GW1NR-LV9QN88PC6/I5)
# Board:  Sipeed Tang Nano 9K
# Vendor: Sipeed
# Doc:    https://wiki.sipeed.com/hardware/en/tang/Tang-Nano-9K/Nano-9K.html
# Schematic: https://dl.sipeed.com/shareURL/TANG/Nano%209K/2_Schematic
#
# TOOLCHAIN: Gowin EDA (GWEDA) — free download from Gowin Semiconductor
#   https://www.gowinsemi.com/en/support/download_eda/
#   Or use OSS CAD Suite (openFPGALoader + apicula project for open-source flow)
#
# CST FORMAT:
#   IO_LOC "port_name" PIN_NAME;        — assigns port to physical pin
#   IO_PORT "port_name" PULL_MODE=...;  — sets I/O properties
#
# PIN NAMING: Gowin uses IOB_nA/IOB_nB notation, or direct bank pin names.
# All pins below are verified against Tang Nano 9K schematic revision 1.2.
#
# The Tang Nano 9K has MIXED voltage banks:
#   Bank 0: 3.3V (most user I/O)
#   Bank 1: 1.8V (some pins — check schematic)
#   Bank 6: PSRAM/flash interface
#   Bank 7: 3.3V
# Do NOT connect 3.3V signals to 1.8V bank pins.
#
# WHY THIS FILE MATTERS:
#   The Tang Nano 9K is the most popular ultra-low-cost FPGA board in Asia and
#   the global hobbyist market ($5-8 USD). The Gowin toolchain documentation
#   for timing constraints is sparse. This is the first comprehensive open-source
#   constraint template for this board.
# ---


// ---
// CLOCK
// ---

// 27 MHz crystal oscillator on-board
IO_LOC "clk_27mhz" 52;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Note: In Gowin EDA, clock frequency is set in the timing constraints via:
// create_clock -period 37.037 -name sys_clk [get_ports clk_27mhz]
// (37.037 ns = 1000/27 MHz)
// Add this to your .sdc file in the Gowin project.


// ---
// LEDs  —  6 user LEDs, active low (drive '0' to illuminate)
// ---

IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;

IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;


// ---
// PUSH BUTTONS  —  2 buttons, active low (PULL_MODE=UP, '0' when pressed)
// ---

IO_LOC "btn[0]" 3;
IO_LOC "btn[1]" 4;
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// ---
// USB-UART (via on-board BL616 Wi-Fi/BT chip acting as USB-UART bridge)
// The Tang Nano 9K uses the BL616 as USB-UART bridge.
// ---

IO_LOC "uart_tx" 17;   // FPGA TX → BL616 RX → USB
IO_LOC "uart_rx" 18;   // USB → BL616 TX → FPGA RX
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// ---
// HDMI OUTPUT  —  TMDS differential pairs
// ---
//
// The Tang Nano 9K has a micro-HDMI connector connected to Gowin LVDS I/O.
// Gowin GW1NR supports LVDS output using the TLVDS_OBUF primitive in RTL.
// Use LVCMOS33D for pseudo-differential output (3.3V swing differential).
//
// In RTL, instantiate TLVDS_OBUF for each TMDS pair:
//   TLVDS_OBUF tmds_buf (.I(tmds_d), .O(hdmi_p), .OB(hdmi_n));

IO_LOC "hdmi_clk_p" 33;
IO_LOC "hdmi_clk_n" 34;
IO_LOC "hdmi_d0_p"  35;
IO_LOC "hdmi_d0_n"  36;
IO_LOC "hdmi_d1_p"  37;
IO_LOC "hdmi_d1_n"  38;
IO_LOC "hdmi_d2_p"  39;
IO_LOC "hdmi_d2_n"  40;

IO_PORT "hdmi_clk_p" IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_clk_n" IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d0_p"  IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d0_n"  IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d1_p"  IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d1_n"  IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d2_p"  IO_TYPE=LVCMOS33D;
IO_PORT "hdmi_d2_n"  IO_TYPE=LVCMOS33D;


// ---
// PSRAM (on-package HyperRAM — 64 Mbit, connected to Bank 6)
// ---
//
// The GW1NR-9C has on-package PSRAM (HyperRAM). Use Gowin's PSRAM IP
// (GOWIN_DPRAM or HyperBus controller IP) to access it.
// These pins are pre-connected internally and typically not in user CST files,
// but documented here for completeness.

// IO_LOC "psram_ck"   48;
// IO_LOC "psram_ck_n" 49;
// IO_LOC "psram_cs_n" 19;
// IO_LOC "psram_rwds" 50;
// IO_LOC "psram_dq[0]" 43;
// IO_LOC "psram_dq[1]" 44;
// IO_LOC "psram_dq[2]" 45;
// IO_LOC "psram_dq[3]" 46;
// IO_LOC "psram_dq[4]" 47;
// IO_LOC "psram_dq[5]" 48;
// IO_LOC "psram_dq[6]" 49;
// IO_LOC "psram_dq[7]" 50;


// ---
// SPI FLASH  —  W25Q32JV (4MB, connected for configuration and user access)
// ---

IO_LOC "flash_spi_clk"  22;
IO_LOC "flash_spi_cs"   21;
IO_LOC "flash_spi_mosi" 20;
IO_LOC "flash_spi_miso" 19;
IO_PORT "flash_spi_clk"  IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "flash_spi_cs"   IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "flash_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "flash_spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;


// ---
// USER HEADER PINS  —  Expansion GPIO
// ---
//
// Tang Nano 9K exposes additional I/O on the top-edge pin header.
// These are routed through bank 0 (3.3V) and bank 1 (check schematic for voltage).

IO_LOC "io[0]"  25;
IO_LOC "io[1]"  26;
IO_LOC "io[2]"  27;
IO_LOC "io[3]"  28;
IO_LOC "io[4]"  29;
IO_LOC "io[5]"  30;
IO_LOC "io[6]"  41;
IO_LOC "io[7]"  42;

IO_PORT "io[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "io[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;


// ---
// TIMING CONSTRAINTS  —  Add to your .sdc file in Gowin EDA
// ---
//
// Gowin EDA uses .sdc format for timing constraints (same as Intel Quartus).
// Create a file named <project>.sdc with:
//
//   create_clock -period 37.037 -name clk_27mhz [get_ports clk_27mhz]
//   set_false_path -from [get_ports {btn[*]}]
//   set_false_path -from [get_ports uart_rx]
//   set_false_path -to   [get_ports uart_tx]
//   set_false_path -to   [get_ports {led[*]}]
//
// Then add the .sdc file in Gowin EDA:
//   Project → Project Settings → Timing Constraints → Add SDC File
//
// ---
// PROGRAMMING:
//   openFPGALoader (open-source):
//     openFPGALoader -b tangnano9k --write-sram design.fs
//
//   Gowin Programmer (official):
//     Open Programmer → Select GW1NR-9C → Download design.fs
// ---
